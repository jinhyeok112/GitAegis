# Keep these server-only values in .env.local. Never use NEXT_PUBLIC_ for secrets.
AUTH_URL=http://localhost:3000
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep the same value after server restarts to preserve existing sessions.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Local MySQL. Use a dedicated application account outside development.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gitaegis
MYSQL_USER=
MYSQL_PASSWORD=

# Generate once with the same randomBytes command above; keep stable for decryption.
GITHUB_TOKEN_ENCRYPTION_KEY=

# GitHub OAuth App settings:
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
