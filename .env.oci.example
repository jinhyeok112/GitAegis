# Copy to .env.oci on the OCI instance. Use the public HTTPS origin, without a trailing slash.
AUTH_URL=https://gitaegis.example.com
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Generate three separate values with: openssl rand -hex 32
AUTH_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# This value instead requires a 32-byte base64url key. See docs/oci-docker.md.
GITHUB_TOKEN_ENCRYPTION_KEY=

# Optional for source-code remediation suggestions.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
